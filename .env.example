# Uygulama, anahtar yokken yerel demo deposu ile çalışır.
# Supabase bağlamak için değerleri doldurun; service role anahtarını asla istemciye koymayın.
# Yüklemelerin Vercel'de kalması için SQL editöründe supabase/migrations/0002_runtime_state.sql çalıştırın.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Oturum çerezi imzası (en az 32 karakter)
SESSION_SECRET=yerel-demo-icin-degistirin-lutfen-32kr

# true: yerel anonim demo verisi ve demo giriş hesapları
DEMO_MODE=true
